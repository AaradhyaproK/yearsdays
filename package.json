{
  "name": "agecalc",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:seo": "node scripts/validate-seo-and-links.mjs",
    "verify:adsense": "node scripts/verify-adsense-readiness.mjs",
    "audit": "node scripts/validate-seo-and-links.mjs && node scripts/verify-adsense-readiness.mjs",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.1.0",
    "@astrojs/preact": "^4.0.5",
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.4.2",
    "preact": "^10.25.4",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "lunar-javascript": "^1.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
