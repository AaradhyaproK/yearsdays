---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '404 - Page Not Found';
const description = 'The requested chronological resource or calculator could not be found.';

const popularTools = [
  { slug: 'days-between-dates', name: 'Days Between Dates Calculator', desc: 'Exact calendar difference with or without end day inclusion.' },
  { slug: 'birthday-countdown', name: 'Birthday Countdown', desc: 'Real-time live countdown down to the exact second.' },
  { slug: 'days-alive', name: 'Days Alive Calculator', desc: 'Discover your 10,000-day and 20,000-day milestone dates.' },
  { slug: 'pet-age', name: 'Pet Age in Human Years', desc: 'Veterinary non-linear age curves for cats and dogs.' },
];
---

<BaseLayout title={title} description={description} lang="en" currentPath="/404/">
  <div class="py-12 max-w-2xl mx-auto space-y-8 text-center">
    <div class="text-7xl font-bold text-[#5e6ad2] font-mono tracking-tight">404</div>
    <div class="space-y-2">
      <h1 class="text-3xl font-semibold text-[#f7f8f8]">
        Page Not Found
      </h1>
      <p class="text-base text-[#8a8f98]">
        The chronological page or tool you are looking for does not exist or has been relocated.
      </p>
    </div>

    <div>
      <a
        href="/"
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-[8px] bg-[#5e6ad2] hover:bg-[#828fff] text-white font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5e6ad2]"
      >
        Return to Age Calculator
      </a>
    </div>

    <div class="pt-8 border-t border-[#18191a] text-left">
      <h2 class="text-base font-semibold text-[#f7f8f8] mb-4 text-center">
        Explore Popular Chronological Tools
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {popularTools.map((tool) => (
          <a
            href={`/tools/${tool.slug}/`}
            class="p-4 rounded-[8px] border border-[#23252a] bg-[#0f1011] hover:bg-[#141516] hover:border-[#34343a] transition-all"
          >
            <div class="font-medium text-sm text-[#f7f8f8]">
              {tool.name}
            </div>
            <div class="text-xs text-[#8a8f98] mt-1">
              {tool.desc}
            </div>
          </a>
        ))}
      </div>
      <div class="mt-4 text-center">
        <a
          href="/tools/"
          class="text-xs font-mono text-[#5e6ad2] hover:text-[#828fff] hover:underline"
        >
          View all 6 calculation tools &rarr;
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
