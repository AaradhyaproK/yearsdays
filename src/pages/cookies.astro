---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Cookie Policy - YearsDays';
const description = 'Detailed explanation of essential cookies, functional local storage, and advertising consent mechanisms.';
---

<BaseLayout title={title} description={description} lang="en" currentPath="/cookies/">
  <div class="space-y-6">
    <Breadcrumbs lang="en" items={[{ label: 'Cookie Policy' }]} />

    <div class="bg-[#0f1011] border border-[#23252a] rounded-[12px] p-6 sm:p-10 shadow-sm space-y-6 text-sm text-[#d0d6e0] leading-relaxed">
      <h1 class="text-3xl font-semibold text-[#f7f8f8] tracking-tight">
        Cookie Policy
      </h1>
      <p class="text-xs font-mono text-[#62666d]">Last Updated: November 9, 2026</p>

      <div class="space-y-3">
        <h2 class="text-lg font-semibold text-[#f7f8f8]">1. What We Store Locally</h2>
        <p class="text-[#8a8f98]">
          Our core application executes all chronological arithmetic locally in your browser. We do not use cookies to track user identities or save dates of birth.
        </p>
        <ul class="list-disc pl-5 space-y-1 text-xs text-[#8a8f98]">
          <li><strong>Theme:</strong> Stored in <code class="font-mono text-[#828fff]">localStorage</code> to remember your Light or Dark display choice.</li>
          <li><strong>Consent Acknowledgment:</strong> Stored in <code class="font-mono text-[#828fff]">localStorage</code> to prevent repetitive consent prompts.</li>
        </ul>
      </div>

      <div class="space-y-3 pt-4 border-t border-[#18191a]">
        <h2 class="text-lg font-semibold text-[#f7f8f8]">2. Third-Party Advertising Cookies</h2>
        <p class="text-[#8a8f98]">
          When monetization is active, certified partners (such as Google AdSense) may place cookies to serve relevant advertisements. Users in the EEA, UK, Switzerland, and Brazil have full granular controls via our Google-certified Consent Management Platform (CMP).
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
