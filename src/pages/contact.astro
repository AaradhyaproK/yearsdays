---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Contact Us - YearsDays';
const description = 'Get in touch with our editorial and development team. Inquiries, feedback, and technical support.';
---

<BaseLayout title={title} description={description} lang="en" currentPath="/contact/" isAppPage={false}>
  <div class="space-y-6">
    <Breadcrumbs lang="en" items={[{ label: 'Contact' }]} />

    <div class="max-w-2xl mx-auto bg-[#0f1011] border border-[#23252a] rounded-[12px] p-6 sm:p-10 shadow-sm space-y-6">
      <div>
        <h1 class="text-3xl font-semibold text-[#f7f8f8] tracking-tight">
          Contact Us
        </h1>
        <p class="text-sm text-[#8a8f98] mt-2 leading-relaxed">
          Have a question about our calculation engine, found a bug, or want to suggest a new tool? We value your feedback.
        </p>
      </div>

      <div class="p-4 bg-[#141516] border border-[#23252a] rounded-[8px] text-xs text-[#8a8f98] space-y-1 font-mono">
        <div><strong class="text-[#f7f8f8]">Official Support Email:</strong> support@yearsdays.info</div>
        <div><strong class="text-[#f7f8f8]">Response Time:</strong> Typically within 1–2 business days.</div>
      </div>

      <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for your message! Our team will respond shortly.');">
        <div>
          <label for="contact-name" class="block text-xs uppercase font-medium text-[#8a8f98] tracking-wider mb-1.5">
            Your Name
          </label>
          <input
            id="contact-name"
            type="text"
            required
            class="w-full px-3 py-2 rounded-[8px] border border-[#23252a] bg-[#010102] text-sm text-[#f7f8f8] focus-visible:ring-2 focus-visible:ring-[#5e6ad2] focus-visible:outline-none"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-xs uppercase font-medium text-[#8a8f98] tracking-wider mb-1.5">
            Email Address
          </label>
          <input
            id="contact-email"
            type="email"
            required
            class="w-full px-3 py-2 rounded-[8px] border border-[#23252a] bg-[#010102] text-sm text-[#f7f8f8] focus-visible:ring-2 focus-visible:ring-[#5e6ad2] focus-visible:outline-none"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-xs uppercase font-medium text-[#8a8f98] tracking-wider mb-1.5">
            Message
          </label>
          <textarea
            id="contact-message"
            rows="5"
            required
            class="w-full px-3 py-2 rounded-[8px] border border-[#23252a] bg-[#010102] text-sm text-[#f7f8f8] focus-visible:ring-2 focus-visible:ring-[#5e6ad2] focus-visible:outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-2.5 px-4 rounded-[8px] bg-[#5e6ad2] hover:bg-[#828fff] text-white font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5e6ad2]"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
