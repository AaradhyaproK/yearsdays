---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getTranslations, getLocalizedPath, type SupportedLocale } from '../i18n/utils';

interface Props {
  lang: SupportedLocale;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;
const t = getTranslations(lang);
const homePath = getLocalizedPath('', lang);
const toolsPath = getLocalizedPath('tools', lang);
const isToolsActive = currentPath.includes('/tools');
---

<header class="border-b border-[#23252a] [html.light_&]:border-[#dbe0e8] bg-[#010102]/95 [html.light_&]:bg-[#f8f9fc]/95 backdrop-blur-xl sticky top-0 z-40 transition-colors w-full">
  <div class="max-w-5xl mx-auto px-2.5 sm:px-6 h-14 flex items-center justify-between gap-1.5 sm:gap-3">
    {/* Brand Logo & Name */}
    <a
      href={homePath}
      class="flex items-center gap-1.5 sm:gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5e6ad2] rounded-md p-0.5 sm:p-1 transition-opacity hover:opacity-90 shrink-0"
      aria-label="YearsDays Home"
    >
      <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-[7px] sm:rounded-[8px] bg-[#0f1011] [html.light_&]:bg-[#edf1f5] border border-[#23252a] [html.light_&]:border-[#dbe0e8] flex items-center justify-center shadow-sm relative group-hover:border-[#34343a] [html.light_&]:group-hover:border-[#cdd3dd] transition-colors shrink-0 overflow-hidden">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-4 h-4 sm:w-[22px] sm:h-[22px]" fill="none">
          <defs>
            <linearGradient id="header-yd-grad" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#5e6ad2" />
              <stop offset="100%" stop-color="#828fff" />
            </linearGradient>
          </defs>
          <!-- Outer Celestial Year Ring -->
          <circle cx="16" cy="16" r="10.5" stroke="#2a2c33" class="[html.light_&]:stroke-[#cdd3dd]" stroke-width="1.25" stroke-dasharray="2 2" />
          <path d="M16 5.5 A10.5 10.5 0 1 1 5.5 16" stroke="url(#header-yd-grad)" stroke-width="2" stroke-linecap="round" />
          <!-- Y & D Chrono Monogram -->
          <path d="M10.5 10.5 L16 16" stroke="#f7f8f8" class="[html.light_&]:stroke-[#0f1011]" stroke-width="2" stroke-linecap="round" />
          <path d="M21.5 10.5 L16 16" stroke="url(#header-yd-grad)" stroke-width="2" stroke-linecap="round" />
          <path d="M16 16 L16 22.5" stroke="#f7f8f8" class="[html.light_&]:stroke-[#0f1011]" stroke-width="2" stroke-linecap="round" />
          <!-- Center Solar Node -->
          <circle cx="16" cy="16" r="2.5" fill="url(#header-yd-grad)" />
          <circle cx="16" cy="16" r="1.2" fill="#ffffff" class="[html.light_&]:fill-[#ffffff]" />
          <!-- Zenith Solar Pip -->
          <circle cx="16" cy="5.5" r="1.5" fill="#828fff" class="[html.light_&]:fill-[#5e6ad2]" />
        </svg>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <span class="font-bold text-sm sm:text-base text-[#f7f8f8] [html.light_&]:text-[#0f1011] tracking-tight block leading-tight">
          Years<span class="text-[#828fff] [html.light_&]:text-[#5e6ad2]">Days</span>
        </span>
        <span class="hidden sm:inline-block text-[9px] font-mono tracking-wider text-[#8a8f98] [html.light_&]:text-[#6b7280] bg-[#141516] [html.light_&]:bg-[#e5e9f0] border border-[#23252a] [html.light_&]:border-[#dbe0e8] px-1.5 py-0.5 rounded-[4px] leading-none">
          .com
        </span>
      </div>
    </a>

    {/* Smart Navigation & Controls (Clean & Unified for Desktop & Mobile in Day & Night Mode) */}
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <a
        href={toolsPath}
        class={`text-xs sm:text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5e6ad2] rounded-[6px] h-8 px-2 sm:px-2.5 border flex items-center gap-1 sm:gap-1.5 ${
          isToolsActive
            ? 'bg-[#5e6ad2]/15 border-[#5e6ad2] text-[#828fff] [html.light_&]:bg-[#5e6ad2]/10 [html.light_&]:text-[#5e6ad2] [html.light_&]:border-[#5e6ad2] font-semibold shadow-sm'
            : 'text-[#d0d6e0] [html.light_&]:text-[#374151] hover:text-[#f7f8f8] [html.light_&]:hover:text-[#0f1011] border-[#23252a] [html.light_&]:border-[#dbe0e8] bg-[#0f1011] [html.light_&]:bg-[#edf1f5] hover:bg-[#141516] [html.light_&]:hover:bg-[#e2e7ec]'
        }`}
        aria-label={t.nav.tools}
      >
        <svg class={`w-3.5 h-3.5 shrink-0 ${isToolsActive ? 'text-[#828fff] [html.light_&]:text-[#5e6ad2]' : 'text-[#5e6ad2]'}`} fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
        </svg>
        <span>{t.nav.tools}</span>
      </a>

      <LanguageSwitcher currentLang={lang} currentPath={currentPath} />

      <button
        id="theme-toggle"
        type="button"
        class="w-8 h-8 rounded-[6px] border border-[#23252a] [html.light_&]:border-[#dbe0e8] bg-[#0f1011] [html.light_&]:bg-[#edf1f5] text-[#8a8f98] [html.light_&]:text-[#6b7280] hover:text-[#f7f8f8] [html.light_&]:hover:text-[#0f1011] hover:border-[#34343a] [html.light_&]:hover:border-[#cdd3dd] transition-all flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5e6ad2] shrink-0"
        aria-label="Toggle visual theme"
      >
        {/* Moon Icon in Light Mode */}
        <svg class="w-4 h-4 hidden [html.light_&]:block text-[#5e6ad2]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
        {/* Warm Golden Sun Icon in Dark Mode */}
        <svg class="w-4 h-4 block [html.light_&]:hidden text-[#f59e0b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  function initThemeToggle() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      document.documentElement.classList.toggle('dark', !isLight);
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });
  }

  initThemeToggle();
</script>
