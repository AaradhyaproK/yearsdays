---
import { getTranslations, getLocalizedPath, type SupportedLocale } from '../i18n/utils';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const links = [
  { href: getLocalizedPath('about', lang), label: t.nav.about },
  { href: getLocalizedPath('contact', lang), label: t.nav.contact },
  { href: getLocalizedPath('privacy', lang), label: t.nav.privacy },
  { href: getLocalizedPath('terms', lang), label: t.nav.terms },
  { href: getLocalizedPath('cookies', lang), label: t.nav.cookies },
  { href: getLocalizedPath('methodology', lang), label: t.nav.methodology },
];
---

<footer class="mt-20 border-t border-[#23252a] bg-[#010102] py-12 sm:py-16 text-xs text-[#8a8f98]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-8">
    {/* Trust & Policy Navigation */}
    <nav aria-label="Trust & Policy" class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {links.map((link) => (
        <a
          href={link.href}
          class="hover:text-[#f7f8f8] font-normal transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5e6ad2] rounded-[4px] px-1 py-0.5"
        >
          {link.label}
        </a>
      ))}
    </nav>

    {/* Architectural Privacy & Legal Guarantees */}
    <div class="text-center max-w-2xl mx-auto space-y-3 text-[#62666d] text-[12px] leading-relaxed">
      <div class="flex items-center justify-center gap-2 text-[#8a8f98]">
        <svg class="w-3.5 h-3.5 text-[#5e6ad2]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>
        <span class="font-medium text-[#d0d6e0]">Zero Data Retention Guarantee</span>
      </div>
      <p>
        Calculations execute 100% locally in your browser. Birthdates and target dates are never stored, logged, or transmitted across any network.
      </p>
      <p class="text-[11px] text-[#62666d]">
        Legal Notice: Chronological thresholds and statutory milestones vary across jurisdictions. Always consult official government gazettes for legal and administrative requirements.
      </p>
      <p class="pt-2 text-[11px] font-mono text-[#62666d]">
        &copy; {new Date().getFullYear()} YearsDays (yearsdays.com). All rights reserved. Engineered with discrete calendar mathematics.
      </p>
    </div>
  </div>
</footer>
